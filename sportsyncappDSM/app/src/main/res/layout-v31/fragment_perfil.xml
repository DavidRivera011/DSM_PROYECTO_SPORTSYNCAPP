<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/sportsync_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp">

        <!-- ENCABEZADO -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Mi perfil"
                android:textColor="@color/sportsync_text_dark"
                android:textSize="25sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEditarPerfil"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:minHeight="36dp"
                android:minWidth="0dp"
                android:paddingHorizontal="12dp"
                android:text="Editar"
                android:textAllCaps="false"
                android:textSize="12sp"
                android:textColor="@color/white"
                app:cornerRadius="18dp"
                app:icon="@drawable/ic_edit"
                app:iconSize="14dp"
                app:iconPadding="4dp"
                app:iconGravity="textStart" />

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Consulta la información de tu cuenta en SportSync."
            android:textColor="@color/sportsync_text_muted"
            android:textSize="13sp"
            android:layout_marginBottom="18dp" />

        <!-- FOTO Y DATOS PRINCIPALES -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginBottom="20dp">

            <ImageView
                android:id="@+id/ivFotoPerfil"
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:src="@drawable/ic_profile"
                android:scaleType="centerCrop"
                android:contentDescription="Foto de perfil"
                android:background="@drawable/bg_perfil_foto"
                android:clipToOutline="true" />

            <TextView
                android:id="@+id/tvNombreCabecera"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Cargando perfil..."
                android:textColor="@color/sportsync_text_dark"
                android:textSize="20sp"
                android:textStyle="bold"
                android:gravity="center"
                android:maxLines="2"
                android:layout_marginTop="10dp" />

            <TextView
                android:id="@+id/tvRolCabecera"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Usuario"
                android:textColor="@color/sportsync_text_dark"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginTop="6dp"
                android:paddingHorizontal="14dp"
                android:paddingVertical="6dp"
                android:background="@drawable/bg_perfil_rol" />

        </LinearLayout>

        <!-- INFORMACIÓN PERSONAL -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp"
            android:background="@drawable/bg_perfil_card">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="INFORMACIÓN PERSONAL"
                android:textColor="@color/sportsync_peach"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:layout_marginBottom="16dp" />

            <!-- NOMBRE COMPLETO -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nombre completo"
                android:textColor="@color/sportsync_peach"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvNombre"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Cargando..."
                android:textColor="@color/sportsync_text_dark"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="14dp" />

            <!-- CORREO ELECTRÓNICO -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Correo electrónico"
                android:textColor="@color/sportsync_peach"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvCorreo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Cargando..."
                android:textColor="@color/sportsync_text_dark"
                android:textSize="14sp"
                android:layout_marginBottom="14dp" />

            <!-- FECHA DE NACIMIENTO -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Fecha de nacimiento"
                android:textColor="@color/sportsync_peach"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvFechaNacimiento"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Cargando..."
                android:textColor="@color/sportsync_text_dark"
                android:textSize="14sp"
                android:layout_marginBottom="14dp" />

            <!-- TIPO DE CUENTA -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tipo de cuenta"
                android:textColor="@color/sportsync_peach"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvRol"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Cargando..."
                android:textColor="@color/sportsync_text_dark"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- MIS SOLICITUDES -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSolicitudes"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="18dp"
            android:backgroundTint="@color/sportsync_peach"
            android:text="Mis solicitudes"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold"
            android:elevation="3dp"
            app:cornerRadius="14dp"
            app:rippleColor="#40FFFFFF" />

        <!-- CERRAR SESIÓN -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCerrarSesion"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="8dp"
            android:backgroundTint="@color/sportsync_text_dark"
            android:text="Cerrar sesión"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold"
            android:elevation="3dp"
            app:cornerRadius="14dp"
            app:rippleColor="#40FFFFFF" />

    </LinearLayout>

</ScrollView>
