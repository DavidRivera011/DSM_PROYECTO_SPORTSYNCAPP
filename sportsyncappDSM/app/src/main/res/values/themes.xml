<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Base.Theme.SportSyncAPP"
        parent="Theme.Material3.DayNight.NoActionBar">

        <item name="android:statusBarColor">@color/sportsync_card_dark</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowActionModeOverlay">false</item>

        <item name="colorPrimary">@color/sportsync_primary_orange</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/sportsync_peach</item>
        <item name="colorOnSecondary">@color/sportsync_text_dark</item>

        <item name="android:windowBackground">@color/sportsync_bg</item>
        <item name="android:navigationBarColor">@color/sportsync_nav_bg</item>

    </style>

    <style name="Theme.SportSyncAPP"
        parent="Base.Theme.SportSyncAPP" />

</resources>
