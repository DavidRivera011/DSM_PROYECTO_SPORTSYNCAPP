<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sportsync_bg"
    android:fillViewport="true"
    android:clipChildren="false"
    android:clipToPadding="false">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="24dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- TARJETA PRINCIPAL -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardLogin"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:layout_marginTop="135dp"
            android:elevation="8dp"
            app:cardBackgroundColor="@color/sportsync_card_dark"
            app:cardCornerRadius="24dp"
            app:cardElevation="8dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="22dp"
                android:paddingEnd="22dp"
                android:paddingTop="72dp"
                android:paddingBottom="22dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Inicio de sesión"
                    android:textColor="@color/sportsync_text_light"
                    android:textSize="25sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Bienvenido a SportSync"
                    android:textColor="@color/sportsync_peach"
                    android:textSize="13sp"
                    android:gravity="center"
                    android:layout_marginBottom="20dp" />

                <!-- MENSAJES DE ERROR -->
                <TextView
                    android:id="@+id/tvError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#FF8A80"
                    android:textSize="13sp"
                    android:gravity="center"
                    android:layout_marginBottom="8dp" />

                <!-- CORREO -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Correo electrónico"
                    android:textColor="@color/sportsync_peach"
                    android:textSize="13sp"
                    android:layout_marginBottom="6dp" />

                <EditText
                    android:id="@+id/etCorreo"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/bg_input_field"
                    android:hint="ejemplo@correo.com"
                    android:inputType="textEmailAddress"
                    android:singleLine="true"
                    android:paddingHorizontal="14dp"
                    android:textColor="@color/sportsync_text_dark"
                    android:textColorHint="@color/sportsync_text_muted"
                    android:textSize="14sp" />

                <!-- CONTRASEÑA -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Contraseña"
                    android:textColor="@color/sportsync_peach"
                    android:textSize="13sp"
                    android:layout_marginBottom="6dp" />

                <EditText
                    android:id="@+id/etContrasena"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/bg_input_field"
                    android:hint="Ingresa tu contraseña"
                    android:inputType="textPassword"
                    android:singleLine="true"
                    android:paddingHorizontal="14dp"
                    android:textColor="@color/sportsync_text_dark"
                    android:textColorHint="@color/sportsync_text_muted"
                    android:textSize="14sp" />

                <!-- RECORDARME Y RECUPERAR CONTRASEÑA -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <CheckBox
                        android:id="@+id/cbRecordar"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:buttonTint="@color/sportsync_peach"
                        android:text="Recordarme"
                        android:textColor="@color/sportsync_peach"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/btnOlvideContrasena"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="¿Olvidaste tu contraseña?"
                        android:textColor="@color/sportsync_peach"
                        android:textSize="11sp"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="4dp" />
                </LinearLayout>

                <!-- INICIAR SESIÓN -->
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnIniciarSesion"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_button_orange"
                    android:backgroundTint="@null"
                    android:text="Iniciar sesión"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <!-- REGISTRO -->
                <TextView
                    android:id="@+id/tvIrARegistro"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center"
                    android:padding="6dp"
                    android:text="¿No tienes cuenta? Crea una aquí"
                    android:textColor="@color/sportsync_peach"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:clickable="true"
                    android:focusable="true" />

                <!-- DIVISOR -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="14dp">

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:background="@color/sportsync_text_muted" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="10dp"
                        android:text="O continúa con"
                        android:textColor="@color/sportsync_text_muted"
                        android:textSize="12sp" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:background="@color/sportsync_text_muted" />
                </LinearLayout>

                <!-- GOOGLE -->
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnGoogle"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/bg_google_button"
                    android:backgroundTint="@null"
                    android:gravity="center"
                    android:text="G    Continuar con Google"
                    android:textAllCaps="false"
                    android:textColor="#202124"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:elevation="2dp" />

                <!-- GITHUB -->
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnGitHub"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_github_button"
                    android:backgroundTint="@null"
                    android:gravity="center"
                    android:text="Continuar con GitHub"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:elevation="2dp" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- LOGO SUPERPUESTO -->
        <ImageView
            android:id="@+id/ivLogo"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:translationY="-60dp"
            android:contentDescription="Logo de SportSync"
            android:src="@drawable/logo_sportsyncapp"
            android:scaleType="fitCenter"
            android:elevation="20dp"
            app:layout_constraintTop_toTopOf="@id/cardLogin"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
