<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_beige"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    android:overScrollMode="ifContentScrolls"
    tools:context=".LoginActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="32dp">

    <!-- LOGO PLACEHOLDER PREMIUM -->
    <FrameLayout
        android:id="@+id/logoContainer"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:layout_marginTop="40dp"
        android:elevation="30dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/ivLogo"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:layout_gravity="center"
            android:src="@drawable/logo_sportsyncapp" />

    </FrameLayout>

    <!-- TARJETA CAFÉ PREMIUM -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cardCafe"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="32dp"
        android:layout_marginTop="145dp"
        android:background="@drawable/bg_tarjeta_cafe"
        android:elevation="24dp"
        android:paddingHorizontal="28dp"
        android:paddingTop="36dp"
        android:paddingBottom="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvTitulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:text="Inicio de sesión"
            android:textColor="@color/texto_blanco"
            android:textSize="26sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvLabelCorreo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:fontFamily="sans-serif-medium"
            android:text="Correo electrónico"
            android:textColor="@color/texto_blanco"
            android:textSize="13sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvTitulo" />

        <EditText
            android:id="@+id/etCorreo"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input_blanco"
            android:elevation="4dp"
            android:fontFamily="sans-serif"
            android:hint="ejemplo@correo.com"
            android:inputType="textEmailAddress"
            android:paddingHorizontal="20dp"
            android:singleLine="true"
            android:textColor="@color/texto_negro"
            android:textColorHint="#9E9E9E"
            android:textSize="15sp"
            app:layout_constraintTop_toBottomOf="@id/tvLabelCorreo" />

        <TextView
            android:id="@+id/tvLabelContrasena"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:fontFamily="sans-serif-medium"
            android:text="Contraseña"
            android:textColor="@color/texto_blanco"
            android:textSize="13sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/etCorreo" />

        <EditText
            android:id="@+id/etContrasena"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input_blanco"
            android:elevation="4dp"
            android:fontFamily="sans-serif"
            android:hint="••••••••"
            android:inputType="textPassword"
            android:paddingHorizontal="20dp"
            android:singleLine="true"
            android:textColor="@color/texto_negro"
            android:textColorHint="#9E9E9E"
            android:textSize="15sp"
            app:layout_constraintTop_toBottomOf="@id/tvLabelContrasena" />

        <!-- RECORDARME -->
        <CheckBox
            android:id="@+id/cbRecordar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:buttonTint="@color/texto_blanco"
            android:fontFamily="sans-serif-medium"
            android:text="Recordarme"
            android:textColor="@color/texto_blanco"
            android:textSize="13sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/etContrasena" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- MENSAJE DE ERROR -->
    <TextView
        android:id="@+id/tvError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="40dp"
        android:layout_marginTop="16dp"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:minHeight="20dp"
        android:textColor="#D32F2F"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@id/cardCafe" />

    <!-- CONTENEDOR DE BOTONES -->
    <LinearLayout
        android:id="@+id/layoutBotones"
        android:baselineAligned="false"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:paddingHorizontal="16dp"
        android:paddingBottom="16dp"
        android:layout_marginTop="8dp"
        android:clipToPadding="false"
        android:orientation="horizontal"
        android:weightSum="2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvError">

        <!-- BOTÓN CONFIRMAR -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnIniciarSesion"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_boton_naranja"
            android:outlineProvider="background"
            android:elevation="8dp"
            android:fontFamily="sans-serif-black"
            android:stateListAnimator="@null"
            android:text="@string/confirmar"
            android:textAllCaps="false"
            android:textColor="@color/texto_blanco"
            android:textSize="15sp" />

        <!-- BOTÓN OLVIDÉ MI CONTRASEÑA -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnOlvideContrasena"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_boton_naranja"
            android:backgroundTint="@color/boton_naranja_claro"
            android:outlineProvider="background"
            android:elevation="8dp"
            android:fontFamily="sans-serif-black"
            android:gravity="center"
            android:includeFontPadding="false"
            android:lineSpacingExtra="-2dp"
            android:paddingHorizontal="4dp"
            android:stateListAnimator="@null"
            android:text="@string/olvid_mi_ncontrase_a"
            android:textAllCaps="false"
            android:textColor="@color/texto_blanco"
            app:autoSizeMaxTextSize="14sp"
            app:autoSizeMinTextSize="10sp"
            app:autoSizeTextType="uniform" />
    </LinearLayout>

    <!-- ENLACE A REGISTRO -->
    <TextView
        android:id="@+id/tvIrARegistro"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:fontFamily="sans-serif-black"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:text="@string/no_tienes_cuenta_crea_una_aqu"
        android:textColor="@color/boton_naranja"
        android:textSize="15sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.496"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutBotones" />

    <!-- SEPARADOR "O CONTINUA CON" -->
    <LinearLayout
        android:id="@+id/layoutSeparador"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="40dp"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvIrARegistro">

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"
            android:background="#D0C4B0" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/o_contin_a_con"
            android:textColor="#8A7A66"
            android:textSize="12sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"
            android:background="#D0C4B0" />

    </LinearLayout>

    <!-- BOTONES SOCIALES -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnGoogle"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginHorizontal="40dp"
        android:layout_marginTop="12dp"
        android:backgroundTint="@color/texto_blanco"
        android:elevation="4dp"
        android:fontFamily="sans-serif-medium"
        android:text="@string/continuar_con_google"
        android:textAllCaps="false"
        android:textColor="@color/texto_negro"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutSeparador" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnGitHub"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginHorizontal="40dp"
        android:layout_marginTop="10dp"
        android:backgroundTint="#24292F"
        android:elevation="4dp"
        android:fontFamily="sans-serif-medium"
        android:text="@string/continuar_con_github"
        android:textAllCaps="false"
        android:textColor="@color/texto_blanco"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnGoogle" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>