<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/swipeRefreshSolicitudes"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sportsync_bg"
    tools:context=".ui.solicitudes.SolicitudesFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Tarjeta para crear una solicitud -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="8dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Solicitar perfil deportivo"
                    android:textColor="@color/sportsync_text_dark"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Selecciona el deporte y el perfil que deseas solicitar."
                    android:textColor="@color/sportsync_text_dark"
                    android:textSize="14sp" />

                <!-- Nombre deportivo opcional -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="Nombre deportivo (opcional)">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etNombreDeportivo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapWords"
                        android:maxLines="1" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Selección de deporte -->
                <Spinner
                    android:id="@+id/spDeportesSolicitud"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="8dp"
                    android:contentDescription="Seleccionar deporte" />

                <!-- Selección del tipo de perfil -->
                <Spinner
                    android:id="@+id/spTipoPerfilSolicitud"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="8dp"
                    android:contentDescription="Seleccionar tipo de perfil" />

                <!-- Institución opcional -->
                <Spinner
                    android:id="@+id/spInstitucionSolicitud"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="8dp"
                    android:contentDescription="Seleccionar institución" />

                <!-- Equipo opcional -->
                <Spinner
                    android:id="@+id/spEquipoSolicitud"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="8dp"
                    android:contentDescription="Seleccionar equipo" />

                <!-- Enviar solicitud -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCrearSolicitud"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Enviar solicitud" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Encabezado del listado -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp"
            android:paddingTop="8dp"
            android:paddingBottom="12dp"
            android:text="Mis solicitudes"
            android:textColor="@color/sportsync_text_dark"
            android:textSize="26sp"
            android:textStyle="bold" />

        <!-- Lista de solicitudes y mensaje de lista vacía -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvSolicitudes"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingHorizontal="16dp"
                android:paddingBottom="16dp"
                android:scrollbars="vertical" />

            <TextView
                android:id="@+id/tvSolicitudesVacio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:padding="24dp"
                android:text="No hay solicitudes registradas."
                android:textColor="@color/sportsync_text_dark"
                android:textSize="14sp"
                android:visibility="gone" />

        </FrameLayout>

    </LinearLayout>

</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
