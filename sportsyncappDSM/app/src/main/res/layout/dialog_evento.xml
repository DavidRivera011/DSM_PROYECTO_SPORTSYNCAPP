<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="16dp"
        android:background="@android:color/white">

        <TextView
            android:id="@+id/tvEventDialogTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Añadir evento"
            android:textColor="#202124"
            android:textSize="23sp"
            android:textStyle="bold"
            android:fontFamily="sans"
            android:layout_marginBottom="6dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Completa la información del evento deportivo."
            android:textColor="#757575"
            android:textSize="14sp"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nombre del evento"
            android:textColor="#424242"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/etEventName"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="Ej. Torneo deportivo UDB"
            android:singleLine="true"
            android:inputType="textCapSentences"
            android:textSize="15sp"
            android:textColor="#202124"
            android:textColorHint="#9E9E9E"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:background="@drawable/bg_team_input" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Fecha del evento"
            android:textColor="#424242"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnEventDate"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_team_input"
            android:backgroundTint="@null"
            android:text="Seleccionar fecha"
            android:textColor="#202124"
            android:textSize="14sp"
            android:textAllCaps="false"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Deporte"
            android:textColor="#424242"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp" />

        <Spinner
            android:id="@+id/spEventSport"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:background="@drawable/bg_team_input"
            android:spinnerMode="dropdown" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Institución"
            android:textColor="#424242"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp" />

        <Spinner
            android:id="@+id/spEventInstitution"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:background="@drawable/bg_team_input"
            android:spinnerMode="dropdown" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Estado del evento"
            android:textColor="#424242"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp" />

        <Spinner
            android:id="@+id/spEventStatus"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:background="@drawable/bg_team_input"
            android:spinnerMode="dropdown" />

    </LinearLayout>
</ScrollView>
