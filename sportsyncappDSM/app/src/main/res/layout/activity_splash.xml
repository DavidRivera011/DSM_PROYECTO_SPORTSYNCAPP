<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sportsync_bg"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- SportSync Logo -->
    <ImageView
        android:id="@+id/ivSplashLogo"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:contentDescription="SportSync Logo"
        android:src="@drawable/ic_sport_ball"
        app:tint="@color/sportsync_primary_orange" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:letterSpacing="0.05"
        android:text="SPORTSYNC"
        android:textColor="@color/sportsync_card_dark"
        android:textSize="32sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Gestión Deportiva Institucional"
        android:textColor="@color/sportsync_text_muted"
        android:textSize="14sp" />

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginTop="48dp"
        android:indeterminateTint="@color/sportsync_primary_orange" />

</LinearLayout>
