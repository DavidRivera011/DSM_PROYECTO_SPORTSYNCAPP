<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sportsync_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="28dp">

        <!-- ENCABEZADO -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Editar perfil"
                android:textColor="@color/sportsync_text_dark"
                android:textSize="26sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Actualiza tus datos personales de SportSync."
            android:textColor="@color/sportsync_text_muted"
            android:textSize="14sp"
            android:layout_marginBottom="20dp" />

        <!-- FORMULARIO -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/sportsync_card_dark"
            app:cardCornerRadius="22dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="DATOS PERSONALES"
                    android:textColor="@color/sportsync_peach"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"
                    android:layout_marginBottom="18dp" />

                <!-- NOMBRE -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Nombre"
                    android:textColor="@color/sportsync_peach"
                    android:textSize="13sp"
                    android:layout_marginBottom="6dp" />

                <EditText
                    android:id="@+id/etNombre"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:background="@drawable/bg_input_field"
                    android:hint="Tu nombre"
                    android:inputType="textPersonName|textCapWords"
                    android:singleLine="true"
                    android:paddingHorizontal="14dp"
                    android:textColor="@color/sportsync_text_dark"
                    android:textColorHint="@color/sportsync_text_muted"
                    android:textSize="14sp"
                    android:layout_marginBottom="16dp" />

                <!-- APELLIDO -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Apellido"
                    android:textColor="@color/sportsync_peach"
                    android:textSize="13sp"
                    android:layout_marginBottom="6dp" />

                <EditText
                    android:id="@+id/etApellido"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:background="@drawable/bg_input_field"
                    android:hint="Tu apellido"
                    android:inputType="textPersonName|textCapWords"
                    android:singleLine="true"
                    android:paddingHorizontal="14dp"
                    android:textColor="@color/sportsync_text_dark"
                    android:textColorHint="@color/sportsync_text_muted"
                    android:textSize="14sp"
                    android:layout_marginBottom="16dp" />

                <!-- CORREO NO EDITABLE -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Correo electrónico"
                    android:textColor="@color/sportsync_peach"
                    android:textSize="13sp"
                    android:layout_marginBottom="6dp" />

                <EditText
                    android:id="@+id/etCorreo"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:background="@drawable/bg_input_field"
                    android:inputType="textEmailAddress"
                    android:singleLine="true"
                    android:focusable="false"
                    android:clickable="false"
                    android:cursorVisible="false"
                    android:paddingHorizontal="14dp"
                    android:textColor="@color/sportsync_text_muted"
                    android:textSize="14sp"
                    android:layout_marginBottom="16dp" />

                <!-- FECHA DE NACIMIENTO -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Fecha de nacimiento"
                    android:textColor="@color/sportsync_peach"
                    android:textSize="13sp"
                    android:layout_marginBottom="6dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_input_field"
                    android:layout_marginBottom="8dp">

                    <EditText
                        android:id="@+id/etFechaNacimiento"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:hint="dd/MM/yyyy"
                        android:focusable="false"
                        android:clickable="true"
                        android:cursorVisible="false"
                        android:paddingStart="14dp"
                        android:paddingEnd="4dp"
                        android:textColor="@color/sportsync_text_dark"
                        android:textColorHint="@color/sportsync_text_muted"
                        android:textSize="14sp" />

                    <ImageButton
                        android:id="@+id/btnSeleccionarFecha"
                        android:layout_width="48dp"
                        android:layout_height="match_parent"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Seleccionar fecha"
                        android:src="@android:drawable/ic_menu_my_calendar"
                        app:tint="@color/sportsync_primary_orange" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Tu correo y tipo de cuenta no se pueden modificar aquí."
                    android:textColor="@color/sportsync_text_muted"
                    android:textSize="12sp"
                    android:layout_marginTop="4dp" />

                <!-- MENSAJES -->
                <TextView
                    android:id="@+id/tvMensaje"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/sportsync_peach"
                    android:textSize="13sp"
                    android:gravity="center"
                    android:layout_marginTop="14dp" />


                <!-- BOTONES DE ACCIÓN -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginTop="18dp">

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnCancelar"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_boton_gris"
                        android:backgroundTint="@null"
                        android:text="Cancelar"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnGuardarCambios"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_button_orange"
                        android:backgroundTint="@null"
                        android:text="Guardar cambios"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                </LinearLayout>


            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>
