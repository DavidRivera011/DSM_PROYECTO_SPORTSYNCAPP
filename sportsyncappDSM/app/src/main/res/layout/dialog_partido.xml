<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="16dp"
        android:background="@android:color/white">

        <TextView
            android:id="@+id/tvMatchDialogTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Añadir partido"
            android:textColor="#202124"
            android:textSize="23sp"
            android:textStyle="bold"
            android:fontFamily="sans"
            android:layout_marginBottom="6dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Completa la información del partido deportivo."
            android:textColor="#757575"
            android:textSize="14sp"
            android:layout_marginBottom="24dp" />

        <!-- Evento -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Evento deportivo"
            android:textColor="#424242"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <Spinner
            android:id="@+id/spinnerEvento"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:background="@drawable/bg_team_input"
            android:spinnerMode="dropdown" />

        <!-- Equipo local -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Equipo local"
            android:textColor="#424242"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp" />

        <Spinner
            android:id="@+id/spinnerEquipoLocal"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:background="@drawable/bg_team_input"
            android:spinnerMode="dropdown" />

        <!-- Equipo visitante -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Equipo visitante"
            android:textColor="#424242"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp" />

        <Spinner
            android:id="@+id/spinnerEquipoVisitante"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:background="@drawable/bg_team_input"
            android:spinnerMode="dropdown" />

        <!-- Fecha -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Fecha del partido"
            android:textColor="#424242"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnFechaPartido"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_team_input"
            android:backgroundTint="@null"
            android:text="Seleccionar fecha"
            android:textColor="#202124"
            android:textSize="14sp"
            android:textAllCaps="false"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp" />

        <!-- Hora -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Hora del partido"
            android:textColor="#424242"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnHoraPartido"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_team_input"
            android:backgroundTint="@null"
            android:text="Seleccionar hora"
            android:textColor="#202124"
            android:textSize="14sp"
            android:textAllCaps="false"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp" />

        <!-- Estado -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Estado del partido"
            android:textColor="#424242"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp" />

        <Spinner
            android:id="@+id/spinnerEstadoPartido"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:background="@drawable/bg_team_input"
            android:spinnerMode="dropdown" />

    </LinearLayout>
</ScrollView>