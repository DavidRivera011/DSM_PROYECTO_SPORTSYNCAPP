<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingVertical="8dp"
    android:paddingHorizontal="16dp"
    android:gravity="center_vertical">

    <TextView
        android:id="@+id/tvPlayerName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="Luis Fernando"
        android:textColor="@color/sportsync_text_dark"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvPlayerPosition"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:text="Delantero"
        android:textColor="@color/sportsync_text_muted"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/tvPlayerTitular"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_badge_approved"
        android:paddingHorizontal="8dp"
        android:paddingVertical="2dp"
        android:text="Titular"
        android:textColor="@color/white"
        android:textSize="11sp"
        android:textStyle="bold" />
</LinearLayout>
