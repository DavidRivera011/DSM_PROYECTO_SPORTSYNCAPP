<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="@color/sportsync_card_dark"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvRankPosition"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_badge_pending"
            android:gravity="center"
            android:text="#1"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvRankName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Luis Fernando Gómez"
                android:textColor="@color/sportsync_text_light"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvRankTeam"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="UES FC - Fútbol"
                android:textColor="@color/sportsync_peach"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvRankPoints"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="18 pts"
            android:textColor="@color/sportsync_primary_orange"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>
</androidx.cardview.widget.CardView>
