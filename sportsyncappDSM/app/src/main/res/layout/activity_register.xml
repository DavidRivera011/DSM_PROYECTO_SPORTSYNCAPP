<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_beige"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    android:overScrollMode="ifContentScrolls"
    tools:context=".RegisterActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="24dp">

        <!-- LOGO ORIGINAL -->
        <ImageView
            android:id="@+id/ivLogo"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:layout_marginTop="40dp"
            android:contentDescription="Logo de SportSync"
            android:src="@drawable/logo_sportsyncapp"
            android:elevation="30dp"
            android:scaleType="fitCenter"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- TARJETA DE REGISTRO -->
        <LinearLayout
            android:id="@+id/cardCafeRegistro"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="28dp"
            android:layout_marginEnd="28dp"
            android:layout_marginTop="135dp"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="42dp"
            android:paddingBottom="24dp"
            android:background="@drawable/bg_tarjeta_cafe"
            android:elevation="20dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- TÍTULO -->
            <TextView
                android:id="@+id/tvTitulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/crear_cuenta"
                android:textColor="@color/texto_blanco"
                android:textSize="22sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-black"
                android:layout_marginBottom="6dp" />

            <!-- INDICADOR DE PASO -->
            <TextView
                android:id="@+id/tvStepIndicator"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Paso 1 de 2: Datos personales"
                android:textColor="@color/sportsync_peach"
                android:textSize="13sp"
                android:layout_marginBottom="20dp" />

            <!-- ====================================== -->
            <!-- PASO 1: DATOS PERSONALES               -->
            <!-- ====================================== -->
            <LinearLayout
                android:id="@+id/layoutStep1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible">

                <!-- NOMBRE -->
                <TextView
                    android:id="@+id/tvLabelNombre"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nombre"
                    android:textColor="@color/texto_blanco"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginBottom="6dp" />

                <EditText
                    android:id="@+id/etNombre"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginBottom="14dp"
                    android:background="@drawable/bg_input_blanco"
                    android:hint="@string/nombre"
                    android:inputType="textPersonName"
                    android:autofillHints="name"
                    android:maxLength="50"
                    android:singleLine="true"
                    android:paddingHorizontal="16dp"
                    android:textColor="@color/texto_negro"
                    android:textColorHint="#9E9E9E"
                    android:textSize="13sp" />

                <!-- APELLIDO -->
                <TextView
                    android:id="@+id/tvLabelApellido"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Apellido"
                    android:textColor="@color/texto_blanco"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginBottom="6dp" />

                <EditText
                    android:id="@+id/etApellido"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/bg_input_blanco"
                    android:hint="@string/apellido"
                    android:inputType="textPersonName"
                    android:autofillHints="name"
                    android:maxLength="50"
                    android:singleLine="true"
                    android:paddingHorizontal="16dp"
                    android:textColor="@color/texto_negro"
                    android:textColorHint="#9E9E9E"
                    android:textSize="13sp" />

                <!-- FECHA DE NACIMIENTO -->
                <TextView
                    android:id="@+id/tvLabelFechaNacimiento"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/fecha_de_nacimiento"
                    android:textColor="@color/texto_blanco"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginBottom="6dp" />

                <LinearLayout
                    android:id="@+id/layoutFechaNacimiento"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:orientation="horizontal"
                    android:layout_marginBottom="20dp">

                    <Spinner
                        android:id="@+id/spDia"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/bg_input_blanco"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:spinnerMode="dropdown"
                        android:dropDownHeight="180dp" />


                    <Spinner
                        android:id="@+id/spMes"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1.6"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_input_blanco"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:spinnerMode="dropdown" />

                    <Spinner
                        android:id="@+id/spAnio"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1.3"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_input_blanco"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:spinnerMode="dropdown" />
                </LinearLayout>

                <!-- BOTONES DEL PASO 1 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnCancelar"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_boton_gris"
                        android:text="@string/cancelar"
                        android:textAllCaps="false"
                        android:textColor="@color/texto_blanco"
                        android:textSize="14sp" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnContinuar"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_boton_naranja"
                        android:text="Siguiente"
                        android:textAllCaps="false"
                        android:textColor="@color/texto_blanco"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

            </LinearLayout>

            <!-- ====================================== -->
            <!-- PASO 2: CREDENCIALES                   -->
            <!-- ====================================== -->
            <LinearLayout
                android:id="@+id/layoutStep2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- CORREO -->
                <TextView
                    android:id="@+id/tvLabelCorreo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Correo electrónico"
                    android:textColor="@color/texto_blanco"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginBottom="6dp" />

                <EditText
                    android:id="@+id/etCorreo"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginBottom="14dp"
                    android:background="@drawable/bg_input_blanco"
                    android:hint="@string/correo_electr_nico"
                    android:inputType="textEmailAddress"
                    android:autofillHints="emailAddress"
                    android:maxLength="100"
                    android:singleLine="true"
                    android:paddingHorizontal="16dp"
                    android:textColor="@color/texto_negro"
                    android:textColorHint="#9E9E9E"
                    android:textSize="13sp" />

                <!-- CONTRASEÑA -->
                <TextView
                    android:id="@+id/tvLabelContrasena"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Contraseña (mínimo 6 caracteres)"
                    android:textColor="@color/texto_blanco"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginBottom="6dp" />

                <EditText
                    android:id="@+id/etContrasena"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginBottom="14dp"
                    android:background="@drawable/bg_input_blanco"
                    android:hint="@string/contrase_a_m_nimo_6_caracteres"
                    android:inputType="textPassword"
                    android:autofillHints="newPassword"
                    android:singleLine="true"
                    android:paddingHorizontal="16dp"
                    android:textColor="@color/texto_negro"
                    android:textColorHint="#9E9E9E"
                    android:textSize="13sp" />

                <!-- CONFIRMAR CONTRASEÑA -->
                <TextView
                    android:id="@+id/tvLabelContrasenaRepeticion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Confirmar contraseña"
                    android:textColor="@color/texto_blanco"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginBottom="6dp" />

                <EditText
                    android:id="@+id/etContrasenaRepeticion"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginBottom="20dp"
                    android:background="@drawable/bg_input_blanco"
                    android:hint="@string/digite_de_nuevo_la_contrase_a"
                    android:inputType="textPassword"
                    android:autofillHints="newPassword"
                    android:singleLine="true"
                    android:paddingHorizontal="16dp"
                    android:textColor="@color/texto_negro"
                    android:textColorHint="#9E9E9E"
                    android:textSize="13sp" />

                <!-- BOTONES DEL PASO 2 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnRegresar"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_boton_gris"
                        android:text="Regresar"
                        android:textAllCaps="false"
                        android:textColor="@color/texto_blanco"
                        android:textSize="14sp" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnRegistrar"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_boton_naranja"
                        android:text="@string/registrarme"
                        android:textAllCaps="false"
                        android:textColor="@color/texto_blanco"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- MENSAJE DE ERROR -->
        <TextView
            android:id="@+id/tvError"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:minHeight="16dp"
            android:textColor="#D32F2F"
            android:textSize="12sp"
            app:layout_constraintTop_toBottomOf="@id/cardCafeRegistro"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
