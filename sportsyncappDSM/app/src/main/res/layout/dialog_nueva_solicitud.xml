<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="22dp"
        android:paddingEnd="24dp"
        android:paddingBottom="20dp"
        android:background="@color/sportsync_bg">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nueva solicitud"
            android:textColor="@color/sportsync_text_dark"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Completa los datos para solicitar tu perfil deportivo."
            android:textColor="@color/sportsync_text_muted"
            android:textSize="13sp"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nombre deportivo (opcional)"
            android:textColor="@color/sportsync_text_dark"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginBottom="7dp" />

        <EditText
            android:id="@+id/etNombreDeportivo"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="Ej. zhe1k"
            android:singleLine="true"
            android:inputType="textCapWords"
            android:textSize="14sp"
            android:textColor="@color/sportsync_text_dark"
            android:textColorHint="@color/sportsync_text_muted"
            android:paddingHorizontal="14dp"
            android:background="@drawable/bg_team_input" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Deporte"
            android:textColor="@color/sportsync_text_dark"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="7dp" />

        <Spinner
            android:id="@+id/spDeportesSolicitud"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:paddingHorizontal="10dp"
            android:background="@drawable/bg_team_input"
            android:spinnerMode="dropdown" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tipo de perfil"
            android:textColor="@color/sportsync_text_dark"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="7dp" />

        <Spinner
            android:id="@+id/spTipoPerfilSolicitud"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:paddingHorizontal="10dp"
            android:background="@drawable/bg_team_input"
            android:spinnerMode="dropdown" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Institución (opcional)"
            android:textColor="@color/sportsync_text_dark"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="7dp" />

        <Spinner
            android:id="@+id/spInstitucionSolicitud"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:paddingHorizontal="10dp"
            android:background="@drawable/bg_team_input"
            android:spinnerMode="dropdown" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Equipo (opcional)"
            android:textColor="@color/sportsync_text_dark"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="7dp" />

        <Spinner
            android:id="@+id/spEquipoSolicitud"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:paddingHorizontal="10dp"
            android:background="@drawable/bg_team_input"
            android:spinnerMode="dropdown" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCrearSolicitud"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="24dp"
            android:text="Enviar solicitud"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textSize="14sp"
            android:backgroundTint="@color/sportsync_peach"
            android:textColor="@color/white"
            app:cornerRadius="14dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelarSolicitud"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="8dp"
            android:text="Cancelar"
            android:textAllCaps="false"
            android:textSize="14sp"
            android:textColor="@color/sportsync_text_dark"
            android:backgroundTint="@android:color/transparent"
            app:cornerRadius="14dp"
            app:strokeColor="@color/sportsync_text_muted"
            app:strokeWidth="1dp" />

    </LinearLayout>
</ScrollView>
